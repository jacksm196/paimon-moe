  "constellations": [
    {
      "name": "Spring Thunder of Fertility",
      "description": "The number of Abundance Amulets that can be generated using <span style=\"color: #FFD780FF;\">Lightning Blade</span> is increased to 3."
    },
    {
      "name": "Violet Vehemence",
      "description": "When Falling Thunder created by <span style=\"color: #FFD780FF;\">Bellowing Thunder</span> hits an opponent, it will decrease their <span style=\"color: #FFACFFFF;\">Electro RES</span> by 15% for 8s."
    },
    {
      "name": "Distant Crackling",
      "description": "Increases the Level of <span style=\"color: #FFD780FF;\">Bellowing Thunder</span> by 3.\nMaximum upgrade level is 15."
    },
    {
      "name": "Fickle Cloudstrike",
      "description": "When a character obtains Abundance Amulets generated by <span style=\"color: #FFD780FF;\">Lightning Blade</span>, if this character's Energy is less than 35%, the Energy restored by the Abundance Amulets is increased by 100%."
    },
    {
      "name": "Clamor in the Wilds",
      "description": "Increases the Level of <span style=\"color: #FFD780FF;\">Lightning Blade</span> by 3.\nMaximum upgrade level is 15."
    },
    {
      "name": "World-Shaker",
      "description": "Every 2 Falling Thunder attacks triggered by <span style=\"color: #FFD780FF;\">Bellowing Thunder</span> will greatly increase the DMG dealt by the next Falling Thunder, which will deal 200% of its original DMG and will restore an additional 1 Energy to the current character."
    }
  ],
  "passives": [
    {
      "name": "Thunderflash",
      "description": "When another nearby character in the party obtains an Abundance Amulet created by <span style=\"color: #FFD780FF;\">Lightning Blade</span>, <span style=\"color: #FFD780FF;\">Lightning Blade's</span> CD is decreased by 1.5s."
    },
    {
      "name": "Resounding Roar",
      "description": "Increases the Energy Recharge effect granted by <span style=\"color: #FFD780FF;\">Lightning Blade</span>'s Abundance Amulet by 10% of the Traveler's Energy Recharge."
    },
    {
      "name": "Foreign Thundertrail",
      "description": "Draw new strength from journeys past. For every element you have resonated with, you gain additional <span style=\"color: #FFD780FF;\">buffs</span>.\n\nIn addition, when nearby party members unleash an Elemental Burst, Traveler will receive 1 stack of Blade of Resounding Thunder, max 3 stacks. After obtaining 3 stacks of Blade of Resounding Thunder, performing a Charged Attack will consume all stacks of Blade of Resounding Thunder and transform into the special <span style=\"color: #FFD780FF;\">Charged Attack: Detonate</span>.\n\n<span style=\"color: #FFD780FF;\">Charged Attack: Detonate</span>\n· Each Charged Attack hit deals increased <span style=\"color: #FFACFFFF;\">Electro DMG</span>. Increase in DMG is equal to 100% of Traveler's ATK. \n· 3s after hitting the enemy, 1 additional lightning strike will be triggered, dealing <span style=\"color: #FFACFFFF;\">Electro DMG</span> equal to 200% of Traveler's ATK. 1 Abundance Amulet will also be created. This DMG is considered Charged Attack DMG.\n· <span style=\"color: #FFD780FF;\">Charged Attack: Detonate</span> can be triggered up to once every 15s."
    }
  ],
  "burst": {
    "name": "Bellowing Thunder",
    "description": "You call upon the protection of lightning, knocking nearby opponents back and dealing <span style=\"color: #FFACFFFF;\">Electro DMG</span> to them.\n\n<span style=\"color: #FFD780FF;\">Lightning Shroud</span>\nWhen your active character's Normal or Charged Attacks hit opponents, they will call Falling Thunder forth, dealing <span style=\"color: #FFACFFFF;\">Electro DMG.</span>\nWhen Falling Thunder hits opponents, it will regenerate Energy for that character.\nOne instance of Falling Thunder can be generated every 0.5s.\n\n<i>You and Paimon studied the light that flashes through the clouds.</i>",
    "skillLabels": [
      "Skill DMG",
      "Falling Thunder DMG",
      "Energy Regeneration",
      "Duration",
      "CD",
      "Energy Cost"
    ],
