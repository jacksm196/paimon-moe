  "statGrow": "critRate",
  "constellations": [
    {
      "name": "Winter's Farewell Feast",
      "description": "When in the <span style=\"color: #FFD780FF;\"><button data-link=\"11430001\">Armed for Action</button></span> mode, Vesna can unleash <span style=\"color: #FFD780FF;\"><button data-link=\"11430003\">Windborne Sword</button></span> at the highest level 4 times instead of 3. Also, each time she enters the <span style=\"color: #FFD780FF;\">Armed for Action</span> mode, she will not consume <span style=\"color: #FFD780FF;\"><button data-link=\"11430002\">Sword Essence</button></span> the first time she uses <span style=\"color: #FFD780FF;\">Windborne Sword</span> at the highest level.\nAdditionally, Vesna deals 20% increased Stellar Swirl reaction DMG when in the <span style=\"color: #FFD780FF;\">Armed for Action</span> mode."
    },
    {
      "name": "Kolo of Spring's Arrival",
      "description": "The Ascension Talent <span style=\"color: #FFD780FF;\"><button data-link-p=\"Rite of Spring's Procession\">Rite of Spring's Procession</button></span> is enhanced: Vesna gains the maximum number of <span style=\"color: #FFD780FF;\">Disciplinary Action</span> stacks when she enters <span style=\"color: #FFD780FF;\"><button data-link=\"11430001\">Armed for Action</button></span> mode. Vesna's ATK is increased by 40% when she has maximum <span style=\"color: #FFD780FF;\">Disciplinary Action</span> stacks.\nYou must unlock the Ascension Talent \"Rite of Spring's Procession\" to gain access to the above effects."
    },
    {
      "name": "Winter's Last Offering",
      "description": "Increases the Level of the Elemental Skill <span style=\"color: #FFD780FF;\"><button data-link-s=\"The Art of Victory\">The Art of Victory</button></span> by 3.\nMaximum upgrade level is 15."
    },
    {
      "name": "Glory to Our Forebears",
      "description": "The Ascension Talent <span style=\"color: #FFD780FF;\"><button data-link-p=\"Truth Prevails\">Truth Prevails</button></span> is enhanced: Its ATK and Elemental Mastery bonuses increase to 3 times their original values."
    },
    {
      "name": "The Nobleborn's Charge",
      "description": "Increases the Level of the Elemental Burst <span style=\"color: #FFD780FF;\"><button data-link-s=\"For the Tsaritsa!\">For the Tsaritsa!</button></span> by 3.\nMaximum upgrade level is 15."
    },
    {
      "name": "Unwavering Ardor",
      "description": "Tapping on Normal Attack or Elemental Skill in the 5s after Vesna uses <span style=\"color: #FFD780FF;\"><button data-link=\"11430003\">Windborne Sword</button></span> at its highest level will unleash the secret Vila ability <span style=\"color: #FFD780FF;\">Windborne Sword: Transpose</span>, dealing <span style=\"color: #80FFD7FF;\">Anemo DMG</span> at 150% of Vesna's ATK as well as summoning <span style=\"color: #FFD780FF;\"><button data-link=\"11430004\">Spirit Blades</button></span> which deal an additional instance of <span style=\"color: #80FFD7FF;\">Anemo DMG</span> at 200% of Vesna's ATK. If Vesna is in the <span style=\"color: #FFD780FF;\"><button data-link=\"11430001\">Armed for Action</button></span> mode, she will also summon a wind pinion to perform Coordinated Attacks against opponents.\nAdditionally, Vesna's Stellar Swirl reaction DMG dealt is <button data-link=\"11190007\"><span style=\"color: #FFD780FF;\">elevated</span></button> by 20%."
    }
  ],
  "passives": [
    {
      "name": "Rite of Spring's Procession",
      "description": "After Vesna uses the special Elemental Skill <span style=\"color: #FFD780FF;\"><button data-link=\"11430003\">Windborne Sword</button></span> or the Elemental Burst <span style=\"color: #FFD780FF;\"><button data-link-s=\"For the Tsaritsa!\">For the Tsaritsa!</button></span>, she also gains 1 stack of <span style=\"color: #FFD780FF;\">Disciplinary Action</span> which lasts 20s. Max 6 stacks, and the duration of each stack is independent of the others'.\nWhen she has <span style=\"color: #FFD780FF;\">Disciplinary Action</span> stacks active, the <span style=\"color: #FFD780FF;\"><button data-link=\"11430004\">Spirit Blades</button></span> summoned by Vesna will deal DMG equal to (100% + 10% × Disciplinary Action stack count) of the original DMG instead. All active stacks of <span style=\"color: #FFD780FF;\">Disciplinary Action</span> are cleared when Vesna uses the Elemental Skill <span style=\"color: #FFD780FF;\">The Art of Victory</span> or when she leaves the field."
    },
    {
      "name": "Truth Prevails",
      "description": "<span style=\"color: #FFD780FF;\">Radiance: Stellar Swirl</span>: Vesna will gain the corresponding effect based on the Elemental Type of her party members: \n· For every <span style=\"color: #99FFFFFF;\">Cryo</span> or <span style=\"color: #80FFD7FF;\">Anemo</span> character in her current party, Vesna's ATK increases by 6%; and\n· For every character of all other Elemental Types in her current party, Vesna's Elemental Mastery increases by 25 instead."
    },
    {
      "name": "Stellar Jubilee: Splendid Prelude",
      "description": "When party members trigger Cryo Swirl, it will be changed to a Stellar Swirl reaction, and party members' Base DMG for the Stellar Swirl will be increased based on Vesna's ATK. Every 100 ATK she has increases the Base Stellar Swirl DMG by 0.7%. The maximum DMG increase that can be gained this way is 14%.\nAfter a party member triggers a Stellar Swirl reaction nearby, Vesna enters the <span style=\"color: #FFD780FF;\">Radiance: Stellar Swirl</span> state for 8s."
    },
    {
      "name": "The Grand Circuit",
      "description": "Holding on Sprint or Jump when Vesna is not in combat will cause her to enter the <span style=\"color: #FFD780FF;\">Coursing</span> state.\n\n<span style=\"color: #FFD780FF;\">Coursing</span>\nContinuously consumes Stamina to hover in mid-air. Sprinting or tapping Jump to go higher expends additional Stamina. Including the hold on Jump that triggers <span style=\"color: #FFD780FF;\">Coursing</span>, Vesna can go higher up to 3 times in each instance of the <span style=\"color: #FFD780FF;\">Coursing</span> state.\n\nAdditionally, in Snezhnaya (excluding Nod-Krai), when Vesna is switched onto the field while the currently active party member is in mid-air and not in combat, she will immediately enter the <span style=\"color: #FFD780FF;\">Coursing</span> state and regenerate 50 Stamina. This effect can trigger once every 10s, and does not take effect in Domains, Trounce Domains, or the Spiral Abyss."
    }
  ],
  "links": {
    "11190007": {
      "title": "Elevation",
      "desc": "Special DMG Boost effect. It is calculated independently of other DMG Boost effects."
    },
    "11430001": {
      "title": "Armed for Action",
      "desc": "Vesna switches to this mode after using the Elemental Skill <span style=\"color: #FFD780FF;\">The Art of Victory</span>. In this mode, which lasts up to 15s:\n· Vesna's resistance to interruption is increased.\n· DMG dealt by Vesna with her Normal Attacks, Charged Attacks, and Plunging Attacks becomes <span style=\"color: #80FFD7FF;\">Anemo DMG</span> that cannot be overridden by another elemental infusion instead. She will also summon a wind pinion that attacks the opponent at the same time, dealing additional <span style=\"color: #80FFD7FF;\">Anemo DMG</span>. Each time the wind pinion is summoned, Vesna will regenerate a certain amount of <span style=\"color: #FFD780FF;\">Sword Essence</span>.\n· Vesna can consume <span style=\"color: #FFD780FF;\">Sword Essence</span> to unleash the special Elemental Skill <span style=\"color: #FFD780FF;\">Windborne Sword</span>, which deals <span style=\"color: #80FFD7FF;\">Anemo DMG</span> to her opponents.\n· Vesna will exit the mode when its duration ends or after she has used <span style=\"color: #FFD780FF;\">Windborne Sword</span> at the highest level 3 times. Exiting will clear all remaining <span style=\"color: #FFD780FF;\">Sword Essence</span> she has accrued."
    },
    "11430002": {
      "title": "Sword Essence",
      "desc": "The energy required to use the special Elemental Skill <span style=\"color: #FFD780FF;\">Windborne Sword</span>while in the <span style=\"color: #FFD780FF;\">Armed for Action</span> mode.\nVesna can accumulate Sword Essence in the following ways:\n· By performing a Normal Attack, Charged Attack, or Plunging attack while in the <span style=\"color: #FFD780FF;\">Armed for Action</span> mode, or by unleashing <span style=\"color: #FFD780FF;\">Windborne Sword: Transpose</span> from the Constellation <span style=\"color: #FFD780FF;\">Unwavering Ardor</span>; \n· By using the Elemental Skill <span style=\"color: #FFD780FF;\">The Art of Victory</span>; or\n· By using the Elemental Burst <span style=\"color: #FFD780FF;\">For the Tsaritsa!</span>"
    },
    "11430003": {
      "title": "Windborne Sword",
      "desc": "When in the <span style=\"color: #FFD780FF;\">Armed for Action</span> mode, Vesna can consume <span style=\"color: #FFD780FF;\">Sword Essence</span> to use her special Elemental Skill to deal <span style=\"color: #80FFD7FF;\">Anemo DMG</span>.\nEach use of the special Elemental Skill <span style=\"color: #FFD780FF;\">Windborne Sword</span> in the same instance of <span style=\"color: #FFD780FF;\">Armed for Action</span> will increase the level of <span style=\"color: #FFD780FF;\">Windborne Sword</span>, beginning from Lv. 1, up to Lv. 3 max.\nUsing <span style=\"color: #FFD780FF;\">Windborne Sword</span> at Lv. 2 and Lv. 3 will also summon a <span style=\"color: #FFD780FF;\">Spirit Blade</span> which deals <span style=\"color: #80FFD7FF;\">Anemo DMG</span>."
    },
    "11430004": {
      "title": "Spirit Blade",
      "desc": "A weapon with special power that Vesna can summon. Attacks the opponent alongside Vesna to deal <span style=\"color: #80FFD7FF;\">Anemo DMG</span>.\nVesna can summon Spirit Blades through the following ways:\n· By unleashing the special Elemental Skill <span style=\"color: #FFD780FF;\">Windborne Sword</span> at Lv. 2 and Lv. 3;\n· By using the Elemental Burst <span style=\"color: #FFD780FF;\">For the Tsaritsa!</span>; or\n· By using <span style=\"color: #FFD780FF;\">Windborne Sword·: Transpose</span> in the Constellation <span style=\"color: #FFD780FF;\">Unwavering Ardor</span>.\n\n<span style=\"color: #FFD780FF;\">Radiance: Stellar Swirl</span>: DMG dealt by the <span style=\"color: #FFD780FF;\">Spirit Blades</span> become <span style=\"color: #80FFD7FF;\">Anemo DMG</span> that is considered Stellar Swirl reaction DMG instead."
    }
  },
