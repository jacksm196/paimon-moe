  "constellations": [
    {
      "name": "Invincible Stonewall",
      "description": "Party members within the radius of <span style=\"color: #FFD780FF;\">Wake of Earth</span> have their CRIT Rate increased by 10% and have increased resistance against interruption."
    },
    {
      "name": "Rockcore Meltdown",
      "description": "When the meteorite created by <span style=\"color: #FFD780FF;\">Starfell Sword</span> is destroyed, it will also explode, dealing additional <span style=\"color: #FFE699FF;\">AoE Geo DMG</span> equal to the amount of damage dealt by Starfell Sword."
    },
    {
      "name": "Will of the Rock",
      "description": "Increases the Level of <span style=\"color: #FFD780FF;\">Wake of Earth</span> by 3.\nMaximum upgrade level is 15."
    },
    {
      "name": "Reaction Force",
      "description": "The shockwave triggered by <span style=\"color: #FFD780FF;\">Wake of Earth</span> regenerates 5 Energy for every opponent hit.\nA maximum of 25 Energy can be regenerated in this manner at any one time."
    },
    {
      "name": "Meteorite Impact",
      "description": "Increases the Level of <span style=\"color: #FFD780FF;\">Starfell Sword</span> by 3.\nMaximum upgrade level is 15."
    },
    {
      "name": "Everlasting Boulder",
      "description": "The barrier created by <span style=\"color: #FFD780FF;\">Wake of Earth</span> lasts 5s longer.\nThe meteorite created by <span style=\"color: #FFD780FF;\">Starfell Sword</span> lasts 10s longer."
    }
  ],
  "passives": [
    {
      "name": "Shattered Darkrock",
      "description": "Reduces <span style=\"color: #FFD780FF;\">Starfell Sword</span>'s CD by 2s."
    },
    {
      "name": "Frenzied Rockslide",
      "description": "The final hit of a Normal Attack combo triggers a collapse, dealing 60% of ATK as <span style=\"color: #FFE699FF;\">AoE Geo DMG</span>."
    },
    {
      "name": "Foreign Adamantine",
      "description": "Draw new strength from journeys past. For every element you have resonated with, you gain additional <span style=\"color: #FFD780FF;\">buffs</span>.\n\nAdditionally, when nearby party members become protected by a shield, when the shield is replaced for any reason, or when <span style=\"color: #FFE699FF;\">Geo Constructs</span> are created, the Traveler will receive 1 stack of Blade of Archaic Petra, max 3 stacks. Up to 1 stack may be obtained every second in this way. After obtaining 3 stacks of Blade of Archaic Petra, performing a Charged Attack will consume all stacks of Blade of Archaic Petra and transform into the special <span style=\"color: #FFD780FF;\">Charged Attack: Rockfell</span>.\n\n<span style=\"color: #FFD780FF;\">Charged Attack: Rockfell</span>\n· Each Charged Attack hit deals increased <span style=\"color: #FFE699FF;\">Geo DMG</span>. Increase in DMG is equal to 120% of Traveler's ATK.\n· For 15s after hitting an opponent, nearby party members will have their shield strength temporarily increased by 20%.\n· <span style=\"color: #FFD780FF;\">Charged Attack: Rockfell</span> can be triggered up to once every 15s."
    }
  ],
  "burst": {
    "name": "Wake of Earth",
    "description": "Energizing the Geo deep underground, you set off expanding shockwaves.\nLaunches surrounding opponents back and deals <span style=\"color: #FFE699FF;\">AoE Geo DMG</span>.\nA stone wall is erected at the edges of the shockwave.\nThe stone wall is considered a <span style=\"color: #FFE699FF;\">Geo Construct</span>, and may be used to block attacks.\n\n<i>You and Paimon studied the pulse of the mountains.</i>",
