  "statGrow": "hpPercent",
  "constellations": [
    {
      "name": "Waters in Full Splendor",
      "description": "Each time Vodyanitsa triggers the healing effect of <span style=\"color: #FFD780FF;\"><button data-link-s=\"Song of Ages Past\">Song of Ages Past</button></span>, it also increases the ATK of all nearby party members by 0.8% of her Max HP for 5s."
    },
    {
      "name": "Echoes That Pierce the Snow",
      "description": "When the <span style=\"color: #FFD780FF;\">Horn of Spring's Call</span> from the Elemental Skill <span style=\"color: #FFD780FF;\">Rechitativ: Sonorous Dawn</span> attacks the opponent, Vodyanitsa gains the \"Two Voices in Black and White\" effect which increases the CRIT DMG from <span style=\"color: #80C0FFFF;\">Hydro DMG</span> and <span style=\"color: #99FFFFFF;\">Cryo DMG</span> dealt by the currently active party member by 50% for 5s.\nIf there is a Wandering Vortex present on the field or in the 5s after a Wandering Vortex explodes, the effect changes to: increases the CRIT DMG from Stellar Swirl reaction DMG caused by the currently active party member by 60% for 5s.\nAdditionally, the Elemental Skill <span style=\"color: #FFD780FF;\">Rechitativ: Sonorous Dawn</span> is enhanced as follows: the duration of the <span style=\"color: #FFD780FF;\"><button data-link-s=\"Song of Ages Past\">Song of Ages Past</button></span> effect is extended by 9s."
    },
    {
      "name": "Song Lingering on a Spring Morning",
      "description": "Increases the Level of the Elemental Skill <span style=\"color: #FFD780FF;\"><button data-link-s=\"Rechitativ: Sonorous Dawn\">Rechitativ: Sonorous Dawn</button></span> by 3.\nMaximum upgrade level is 15."
    },
    {
      "name": "Melancholic Voice Upon the Gentle Waters",
      "description": "When Vodyanitsa triggers the healing effect of <span style=\"color: #FFD780FF;\"><button data-link-s=\"Song of Ages Past\">Song of Ages Past</button></span>, an additional effect will be triggered based on the healed character's HP.\n· If the character's HP is below 40%: The healing is increased by 50%; and\n· If the character's HP is 40% or above: Vodyanitsa's Max HP is increased by 20% for 6s. Max 3 stacks, and each stack's duration is counted independently."
    },
    {
      "name": "Together, Down Into the Deep",
      "description": "Increases the Level of the Elemental Burst <span style=\"color: #FFD780FF;\"><button data-link-s=\"Koda: Sink With Thee\">Koda: Sink With Thee</button></span> by 3.\nMaximum upgrade level is 15."
    },
    {
      "name": "Neverending Song of Revelry",
      "description": "The Constellation <span style=\"color: #FFD780FF;\">Echoes That Pierce the Snow</span> is enhanced: \"Two Voices in Black and White\" now applies to all nearby party members.\nAdditionally, while the <span style=\"color: #FFD780FF;\"><button data-link-s=\"Song of Ages Past\">Song of Ages Past</button></span> effect is active, Stellar Swirl reaction DMG dealt by nearby party members is <button data-link=\"11190007\"><span style=\"color: #FFD780FF;\">elevated</span></button> by 25% while <span style=\"color: #80C0FFFF;\">Hydro DMG</span> and <span style=\"color: #99FFFFFF;\">Cryo DMG</span> dealt are increased by 60%."
    }
  ],
  "passives": [
    {
      "name": "The Last Djeguako Songstress",
      "description": "When the Elemental Skill <span style=\"color: #FFD780FF;\">Rechitativ: Sonorous Dawn</span> is used, any Stellar Vortex on the field will turn into a Wandering Vortex instead. While the <span style=\"color: #FFD780FF;\"><button data-link-s=\"Song of Ages Past\">Song of Ages Past</button></span> effect is active, nearby party members' Stellar Swirl reactions will generate Wandering Vortex instead.\nGenerating or detonating a Wandering Vortex will also reduce nearby opponents' <span style=\"color: #80FFD7FF;\">Anemo RES</span> by 35% for 6s. \nAdditionally, nearby party members who enter the <span style=\"color: #FFD780FF;\">Radiance: Stellar Swirl</span> state while <span style=\"color: #FFD780FF;\">Song of Ages Past</span> is in effect will have the <span style=\"color: #FFD780FF;\">Radiance: Stellar Swirl</span> state extended by 4s."
    },
    {
      "name": "Dirge of the Fandyr",
      "description": "When the Elemental Skill <span style=\"color: #FFD780FF;\">Rechitativ: Sonorous Dawn</span> is used, Vodyanitsa will also gain 25 stacks of <button data-link=\"11400001\"><span style=\"color: #FFD780FF;\">Lead Vocal</span></button> as well as 10 stacks of <button data-link=\"11400002\"><span style=\"color: #FFD780FF;\">Chorus</span></button>.\nThe two effects above last 30s each, and the stack count is refreshed when the Elemental Skill is used."
    },
    {
      "name": "Echoes Over the Frozen Lake",
      "description": "Holding the Elemental Skill outside of combat will cause Vodyanitsa to embody her true Water Imp form and swim for up to 10s at the cost of Stamina. Naturally, as a Water Imp, she can also move across the water's surface. Vodyanitsa will exit her Water Imp form when the Elemental Skill is used again, when the duration ends, or when all Stamina is depleted.\nAdditionally, while Vodyanitsa can swim faster, her Stamina consumption rate is also increased."
    },
    {
      "name": "Heartless Siren Song",
      "description": "As the Prima Donna of the Korolevskiy Troupe, Vodyanitsa sings in person in place of playing an instrument."
    }
  ],
  "links": {
    "11190007": {
      "title": "Elevation",
      "desc": "Special DMG Boost effect. It is calculated independently of other DMG Boost effects."
    },
    "11400001": {
      "title": "Lead Vocal",
      "desc": "When the party's currently active character deals <span style=\"color: #80C0FFFF;\">Hydro DMG</span> or <span style=\"color: #99FFFFFF;\">Cryo DMG</span> with a Normal Attack, Charged Attack, Plunging Attack, Elemental Skill, or Elemental Burst, 1 stack of \"Lead Vocal\" is consumed. This in turn increases the DMG dealt. However, if a Wandering Vortex is present on the field or during the 5s following a Wandering Vortex explosion, this effect will only trigger when the character deals Stellar Swirl reaction DMG.\nEvery 1000 Max HP Vodyanitsa has in excess of 40000 will increase the Stellar Swirl reaction DMG from the above effect by 260, as well as <span style=\"color: #80C0FFFF;\">Hydro DMG</span> and <span style=\"color: #99FFFFFF;\">Cryo DMG</span> dealt by 140. Stellar Swirl reaction DMG dealt can be increased by a maximum of 6500 while <span style=\"color: #80C0FFFF;\">Hydro DMG</span> and <span style=\"color: #99FFFFFF;\">Cryo DMG</span> can be increased by a maximum of 3500 in this way."
    },
    "11400002": {
      "title": "Chorus",
      "desc": "Triggered by off-field party members or other nearby party members (and not your currently active party member). Effects are the same as those of \"Lead Vocal.\""
    }
  },
  "burst": {
    "name": "Koda: Sink With Thee",
    "description": "Leads a song of the Water Imps which lures its listeners to their doom. This deals <span style=\"color: #80C0FFFF;\">AoE Hydro DMG</span> to the opponent.\nWhen in the <span style=\"color: #FFD780FF;\"><button data-link-s=\"Song of Ages Past\">Song of Ages Past</button></span> state, DMG dealt is further increased.\n\n<i>\"According to legend, the song of the Water Imps can lead sailors to their ruin. But if everyone was lost to the water, where did this story come from?\"\n\"It's probably from a Domovoy sailor who was too short to go over the ship's railing, heh... Stop giving me that look, Odette! I was just joking!\"</i>",
